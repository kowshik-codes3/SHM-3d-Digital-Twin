# ==============================================================================
# StructureIQ Structural Health Monitoring Digital Twin Configuration
# ==============================================================================

# Server & Network Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Core Telemetry & Sampling Parameters
FS=50.0
WINDOW_SIZE=50
PERSISTENCE=3
T_PERSIST=0.04

# Computational Device (cpu / cuda)
DEVICE=cpu

# Database & Artifact Paths (relative to backend or absolute)
DB_PATH=data/shm.db
ARTIFACTS_DIR=artifacts
REPORTS_DIR=reports

# Ingestion Source (simulator / replay / mqtt / kafka / http)
INGESTION_TYPE=simulator
DEMO_MODE=true

# MQTT Broker & Auth Configuration (credentials via env only)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=false
MQTT_CA_CERTS=
MQTT_QOS=1
MQTT_KEEPALIVE=30

# HTTP Ingestion Security & Rate Limiting
SHM_API_KEY_DEFAULT=
MAX_FRAME_PAYLOAD_BYTES=2097152
HTTP_RATE_LIMIT_RPS=200.0
IDEMPOTENCY_TTL_SECONDS=300.0

# Spool & Recovery
SPOOL_DIR=data/spool
SPOOL_MAX_BYTES=10485760
SPOOL_REPLAY_MINUTES=10.0

# Frontend Vite Variables (Used at compile/run time by shm-dashboard)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
